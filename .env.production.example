# Use this file only as a template. Keep .env.production outside source control.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

POSTGRES_DB=form_engine
POSTGRES_USER=form_engine
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-url-safe-random-password

WEB_CONCURRENCY=4
FLOWER_BASIC_AUTH=admin:replace-with-a-strong-password

DJANGO_EMAIL_USE_SMTP=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@example.com
