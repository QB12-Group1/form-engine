# Copy this file to .env and adjust values for your environment.
# .env is git-ignored; never commit real secrets.

# --- Core ---
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Database (PostgreSQL) ---
# Either set DATABASE_URL as a single connection string...
DATABASE_URL=postgres://form_engine:form_engine@localhost:5432/form_engine
# ...or set the individual POSTGRES_* variables below (used if DATABASE_URL is not set).
POSTGRES_DB=form_engine
POSTGRES_USER=form_engine
POSTGRES_PASSWORD=form_engine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Cache (Redis) ---
# Single connection string: redis://[:password@]host:port/db_number
CACHE_URL=redis://localhost:6379/1

# --- Cache (Redis) ---
# Single connection string: redis://[:password@]host:port/db_number
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Flower ---
FLOWER_BASIC_AUTH=admin:replace-with-a-strong-password

# --- Email ---
# Set to true and configure SMTP vars below to send real email (e.g. in staging/production).
DJANGO_EMAIL_USE_SMTP=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost

# --- Google ---
GOOGLE_CLIENT_ID=
